# ---------------------------------------------------------------------------
# SPID File Management System — Environment Configuration
# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in the values from your Supabase
# project: Dashboard -> Project Settings -> API
#
# NEVER put real secret keys in this file or commit them to Git.
# ---------------------------------------------------------------------------

# Supabase project URL (safe to expose to the browser)
# Example: https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable/anon key (safe to expose to the browser).
# New API key format:  sb_publishable_...
# Legacy format:       eyJhbGciOi... ("anon" / "public" role JWT)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase secret/service-role key — SERVER-SIDE ONLY.
# Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_,
# never commit, never expose in browser code, logs, or API responses.
# New API key format:  sb_secret_...
# Legacy format:       eyJhbGciOi... ("service_role" role JWT)
# Used only by server API routes for privileged operations:
#   - admin user management (approve/disable/role changes)
#   - session revocation on account disable
#   - pre-login lockout lookups
SUPABASE_SERVICE_ROLE_KEY=

# Site URL used for password-reset redirect links (no trailing slash).
# Local development: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Session inactivity policy
# ---------------------------------------------------------------------------
# Absolute idle window before the user is signed out, in milliseconds.
# Defaults to 60 minutes (3600000). Must be prefixed NEXT_PUBLIC_ so the
# browser watchdog and the server middleware share the same value.
# NEXT_PUBLIC_SESSION_INACTIVITY_TIMEOUT_MS=3600000

# ---------------------------------------------------------------------------
# Upload malware scanning (server-side only)
# ---------------------------------------------------------------------------
# Engine selection: auto | clamd | clamscan | defender
#   clamd     = ClamAV daemon over TCP (recommended for production)
#   clamscan  = ClamAV command-line scanner
#   defender  = Microsoft Defender MpCmdRun.exe (Windows hosts only)
# `auto` probes clamd, then clamscan, then Defender. If no engine responds,
# uploads and bulk imports FAIL CLOSED — they are never treated as clean.
MALWARE_SCAN_ENGINE=auto

# ClamAV daemon connection (used by the clamd engine)
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# ClamAV CLI binary (used by the clamscan engine)
CLAMSCAN_PATH=clamscan

# Microsoft Defender CLI path (defaults to the standard Windows install path)
# DEFENDER_MPCMDRUN_PATH=C:\Program Files\Windows Defender\MpCmdRun.exe

# Maximum time allowed for one file scan, in milliseconds.
MALWARE_SCAN_TIMEOUT_MS=30000

# Per-category upload limits (bytes). Defaults: 10MB / 20MB / 5MB.
# SECURITY_MAX_EXCEL_UPLOAD_BYTES=10485760
# SECURITY_MAX_DOCUMENT_UPLOAD_BYTES=20971520
# SECURITY_MAX_IMAGE_UPLOAD_BYTES=5242880

# Private quarantine directory. Defaults to the OS temp directory.
# UPLOAD_QUARANTINE_DIR=

# ---------------------------------------------------------------------------
# Database content translation (server-side only)
# ---------------------------------------------------------------------------
# Officer-typed content (file names, section names, storage locations, notes)
# is rendered in Sinhala through a cache table plus these optional provider
# settings. Leave the URL/key empty to translate only the built-in glossary;
# every other value falls back to the English the officer typed.
#
# The URL must be an OpenAI-compatible chat-completions endpoint.
# TRANSLATION_API_URL=https://api.example.com/v1/chat/completions
# TRANSLATION_API_KEY=
# TRANSLATION_MODEL=gpt-4o-mini

